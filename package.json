{
  "name": "offline-wallet-generator",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "check:offline": "./scripts/check-offline-artifact.sh",
    "build:verified": "npm run lint && npm test && npm run build && npm run build:offline && npm run check:offline",
    "serve": "vite preview",
    "test": "node --test",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "node scripts/copy-qrllib.mjs",
    "docs:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@theqrl/qrllib-browserify": "1.1.0",
    "buffer": "6.0.3",
    "jspdf": "4.2.1",
    "print-js": "1.6.0",
    "scrypt-js": "3.0.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@theqrl/wallet-helpers": "4.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.41",
    "daisyui": "5.7.16",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "lightningcss": "1.33.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vue-eslint-parser": "10.4.1"
  }
}
